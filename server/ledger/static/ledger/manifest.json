{
  "name": "Cafe Finance",
  "short_name": "Cafe Finance",
  "description": "Share a payment screenshot or an invoice; it goes into the cafe ledger with proof.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f7f5",
  "theme_color": "#1f6f4a",
  "icons": [
    { "src": "/static/ledger/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/static/ledger/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/share/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["image/*", "application/pdf"] }
      ]
    }
  }
}
